{
  "info": {
    "name": "Fachada Smart API",
    "description": "Backend local do Fachada Smart.\n\nOs arquivos usam caminho absoluto em examples/. Se o Postman reclamar, em Settings → General → Working Directory aponte para a pasta backend e marque 'Allow reading files outside working directory'.\n\nAs requisições de IA consomem créditos (OpenAI/Gemini).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Orçamento (OpenAI)",
      "item": [
        {
          "name": "Orçamento completo — padaria",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('tem itens e totais', () => { pm.expect(r.itens).to.be.an('array'); pm.expect(r.totais).to.have.property('precoSugerido'); });",
                  "pm.test('preço = custo × margem ÷ (1 − imposto)', () => {",
                  "  if (!r.itens.length || r.totais.aplicouValorMinimo) return;",
                  "  const esperado = r.totais.custoTotal * (1 + r.totais.margemPercentual/100) / (1 - r.totais.impostoPercentual/100);",
                  "  pm.expect(r.totais.precoSugerido).to.be.closeTo(esperado, 0.02);",
                  "});",
                  "",
                  "console.log('Preço sugerido: R$', r.totais.precoSugerido, '| pendências:', r.pendencias);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orcamento",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orcamento"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"form\": {\n    \"cliente\": \"Padaria Ferreira\",\n    \"tipo\": \"padaria\",\n    \"descricao\": \"Testeira em ACM de 5 m de largura por 1,20 m de altura, com o nome PADARIA em letra caixa iluminada (7 letras) e LED nas letras.\",\n    \"cores\": \"vermelho e branco\",\n    \"cidade\": \"Caçapava - SP\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Medidas completas: deve calcular sem inventar preço."
          }
        },
        {
          "name": "Orçamento com pendência — sem medidas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('tem itens e totais', () => { pm.expect(r.itens).to.be.an('array'); pm.expect(r.totais).to.have.property('precoSugerido'); });",
                  "pm.test('preço = custo × margem ÷ (1 − imposto)', () => {",
                  "  if (!r.itens.length || r.totais.aplicouValorMinimo) return;",
                  "  const esperado = r.totais.custoTotal * (1 + r.totais.margemPercentual/100) / (1 - r.totais.impostoPercentual/100);",
                  "  pm.expect(r.totais.precoSugerido).to.be.closeTo(esperado, 0.02);",
                  "});",
                  "pm.test('completo = false', () => pm.expect(r.completo).to.eql(false));",
                  "console.log('Preço sugerido: R$', r.totais.precoSugerido, '| pendências:', r.pendencias);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orcamento",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orcamento"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"form\": {\n    \"cliente\": \"Clínica Sorriso\",\n    \"descricao\": \"Quero uma fachada em ACM com letreiro iluminado e um adesivo na vitrine.\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Sem medidas: deve voltar pendencias e completo=false."
          }
