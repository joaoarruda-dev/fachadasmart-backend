            ],
            "url": {
              "raw": "{{baseUrl}}/api/orcamento",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orcamento"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"form\": {\n    \"descricao\": \"Lona impressa de 3 x 1 m e adesivo vinil de 2 x 0,5 m na porta.\"\n  },\n  \"tabelaPrecos\": {\n    \"margemPercentual\": 50,\n    \"impostoPercentual\": 8,\n    \"taxaInstalacao\": 150,\n    \"valorMinimo\": 300,\n    \"materiais\": [\n      {\n        \"id\": \"lona-impressa\",\n        \"nome\": \"Lona impressa\",\n        \"unidade\": \"m2\",\n        \"custoUnitario\": 30,\n        \"maoDeObraPorUnidade\": 15,\n        \"perdaPercentual\": 5\n      },\n      {\n        \"id\": \"adesivo-vinil\",\n        \"nome\": \"Adesivo vinil\",\n        \"unidade\": \"m2\",\n        \"custoUnitario\": 40,\n        \"maoDeObraPorUnidade\": 25,\n        \"perdaPercentual\": 10\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Envia uma tabela própria no corpo, simulando outra empresa."
          }
