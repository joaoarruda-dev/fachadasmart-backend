          "name": "Limpar imagem — referência 2",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('retornou imageUrl', () => pm.expect(r.imageUrl).to.match(/^\\/uploads\\/.+\\.png$/));",
                  "if (r.imageUrl) { pm.environment.set('ultimaImagemUrl', r.imageUrl); console.log('Abrir:', pm.environment.get('baseUrl') + r.imageUrl); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
